---
// src/components/features/landing/comp-audit-tool.astro
---
<section id="audit" class="snap-section audit-section">
  <!-- Patrón de puntos de fondo decorativo -->
  <div class="dots-pattern left"></div>
  <div class="dots-pattern right"></div>
  <!-- Brillos cálidos de fondo a los lados de la tarjeta -->
  <div class="audit-glow glow-left"></div>
  <div class="audit-glow glow-right"></div>

  <a href="#top" class="back-to-top" aria-label="Volver al inicio" title="Volver al inicio">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m18 15-6-6-6 6"></path>
    </svg>
  </a>

  <div class="container audit-container">
    <div class="section-header text-center">
      <!-- Insignia superior -->
      <div class="audit-badge">
        <span class="audit-badge-icon-box">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
          </svg>
        </span>
        <span class="audit-badge-text">AUDITORÍA 100% GRATIS</span>
      </div>
      
      <h2 class="section-title">Auto-Auditoría de <span class="italic-title">Conversión</span></h2>
      <p class="section-subtitle">Descubre el estado de tu negocio digital en 12 preguntas interactivas.</p>
    </div>

    <!-- Wizard de Auto-Auditoría -->
    <div class="audit-card glass-panel" id="audit-wizard">
      
      <!-- Contenedor superior del progreso y la categoría -->
      <div class="wizard-header-row">
        <!-- Barra de progreso e indicador de pregunta -->
        <div class="wizard-progress-block">
          <div class="wizard-progress-bar">
            <div class="progress-fill" id="progress-indicator" style="width: 8.33%;"></div>
          </div>
          <span class="step-counter" id="step-counter">Pregunta 1 de 12</span>
        </div>
        
        <!-- Badge de Categoría con Icono de Mira -->
        <span class="category-badge" id="category-badge">
          <svg class="crosshair-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12">
            <circle cx="12" cy="12" r="10" />
            <line x1="22" y1="12" x2="18" y2="12" />
            <line x1="6" y1="12" x2="2" y2="12" />
            <line x1="12" y1="6" x2="12" y2="2" />
            <line x1="12" y1="22" x2="12" y2="18" />
          </svg>
          <span id="category-text">Claridad</span>
        </span>
      </div>

      <!-- Preguntas del Wizard -->
      <div class="wizard-body">
        <div class="slide-container" id="slides-wrapper">
          
          <!-- Slide 1: Claridad -->
          <div class="audit-slide active" data-index="1" data-category="Claridad">
            <div class="slide-question-content">
              <div class="question-avatar-box">
                <div class="question-avatar-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                    <polyline points="16 11 18 13 22 9" />
                  </svg>
                </div>
              </div>
              <div class="question-texts-box">
                <h3 class="question-text">¿Tus visitas entienden claramente qué vendes y a quién ayudas en los primeros <span class="highlight-q-text">5 segundos</span> de entrar a tu web?</h3>
                <p class="question-desc">Una propuesta de valor confusa es la causa número uno de rebote inmediato.</p>
              </div>
            </div>
          </div>
          
          <!-- Slide 2: Confianza -->
          <div class="audit-slide" data-index="2" data-category="Confianza">
            <div class="slide-question-content">
              <div class="question-avatar-box">
                <div class="question-avatar-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <path d="M9 11l2 2 4-4" />
                  </svg>
                </div>
              </div>
              <div class="question-texts-box">
                <h3 class="question-text">¿Tu sitio muestra <span class="highlight-q-text">testimonios creíbles</span> de clientes reales, con nombres, fotos o enlaces verificables?</h3>
                <p class="question-desc">Sin pruebas sociales reales, las visitas perciben tu sitio como genérico o inseguro.</p>
              </div>
            </div>
          </div>
          
          <!-- Slide 3: Conversión -->
          <div class="audit-slide" data-index="3" data-category="Conversión">
            <div class="slide-question-content">
              <div class="question-avatar-box">
                <div class="question-avatar-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                    <circle cx="12" cy="12" r="10" />
                    <circle cx="12" cy="12" r="6" />
                    <circle cx="12" cy="12" r="2" />
                  </svg>
                </div>
              </div>
              <div class="question-texts-box">
                <h3 class="question-text">¿Tus <span class="highlight-q-text">llamadas a la acción (CTAs)</span> son claras, visibles y orientadas al beneficio directo del cliente?</h3>
                <p class="question-desc">Botones apagados o confusos reducen la tasa de clics a menos de la mitad.</p>
              </div>
            </div>
          </div>
          
          <!-- Slide 4: Diseño -->
          <div class="audit-slide" data-index="4" data-category="Diseño">
            <div class="slide-question-content">
              <div class="question-avatar-box">
                <div class="question-avatar-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                    <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" />
                    <path d="M12 6V12L16 14" />
                  </svg>
                </div>
              </div>
              <div class="question-texts-box">
                <h3 class="question-text">¿El <span class="highlight-q-text">logotipo y el diseño visual</span> de tu marca se ven profesionales, consistentes y adaptados a tu sector?</h3>
                <p class="question-desc">Un diseño amateur resta autoridad frente a competidores establecidos en el mercado.</p>
              </div>
            </div>
          </div>
          
          <!-- Slide 5: Técnico -->
          <div class="audit-slide" data-index="5" data-category="Técnico">
            <div class="slide-question-content">
              <div class="question-avatar-box">
                <div class="question-avatar-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                  </svg>
                </div>
              </div>
              <div class="question-texts-box">
                <h3 class="question-text">¿Tu sitio web se carga completamente en <span class="highlight-q-text">menos de 3 segundos</span> en cualquier conexión móvil estándar?</h3>
                <p class="question-desc">El 53% de los usuarios abandona una página si esta tarda más de 3 segundos en cargar.</p>
              </div>
            </div>
          </div>
          
          <!-- Slide 6: Móvil -->
          <div class="audit-slide" data-index="6" data-category="Móvil">
            <div class="slide-question-content">
              <div class="question-avatar-box">
                <div class="question-avatar-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
                    <line x1="12" y1="18" x2="12.01" y2="18" />
                  </svg>
                </div>
              </div>
              <div class="question-texts-box">
                <h3 class="question-text">¿Tu página se visualiza perfectamente en <span class="highlight-q-text">teléfonos celulares</span> sin textos superpuestos o scrolls horizontales?</h3>
                <p class="question-desc">Más del 60% de tus clientes potenciales te buscarán desde sus dispositivos móviles.</p>
              </div>
            </div>
          </div>
          
          <!-- Slide 7: Captura -->
          <div class="audit-slide" data-index="7" data-category="Captura">
            <div class="slide-question-content">
              <div class="question-avatar-box">
                <div class="question-avatar-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                    <polyline points="10 9 9 9 8 9" />
                  </svg>
                </div>
              </div>
              <div class="question-texts-box">
                <h3 class="question-text">¿Tus <span class="highlight-q-text">formularios de contacto</span> son cortos, directos y rápidos de llenar para la visita?</h3>
                <p class="question-desc">Formularios con más de 4 campos innecesarios ahuyentan a leads altamente interesados.</p>
              </div>
            </div>
          </div>
          
          <!-- Slide 8: Copywriting -->
          <div class="audit-slide" data-index="8" data-category="Copywriting">
            <div class="slide-question-content">
              <div class="question-avatar-box">
                <div class="question-avatar-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
                  </svg>
                </div>
              </div>
              <div class="question-texts-box">
                <h3 class="question-text">¿Los textos de tu web se enfocan en <span class="highlight-q-text">resolver los dolores</span> de tu cliente en lugar de hablar solo de ti?</h3>
                <p class="question-desc">El cliente compra soluciones a sus propios problemas, no tu historia corporativa.</p>
              </div>
            </div>
          </div>
          
          <!-- Slide 9: SEO -->
          <div class="audit-slide" data-index="9" data-category="SEO">
            <div class="slide-question-content">
              <div class="question-avatar-box">
                <div class="question-avatar-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                  </svg>
                </div>
              </div>
              <div class="question-texts-box">
                <h3 class="question-text">¿Aparece tu negocio en la <span class="highlight-q-text">primera página de Google</span> al buscar tu servicio específico en tu ciudad?</h3>
                <p class="question-desc">Si no estás en la primera página de resultados locales, eres invisible orgánicamente.</p>
              </div>
            </div>
          </div>
          
          <!-- Slide 10: Seguridad -->
          <div class="audit-slide" data-index="10" data-category="Seguridad">
            <div class="slide-question-content">
              <div class="question-avatar-box">
                <div class="question-avatar-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                </div>
              </div>
              <div class="question-texts-box">
                <h3 class="question-text">¿Cuenta tu web con un <span class="highlight-q-text">candado de seguridad</span> activo (HTTPS) en la barra del navegador?</h3>
                <p class="question-desc">Los navegadores advierten activamente a los usuarios de "Sitio no seguro", rompiendo la confianza.</p>
              </div>
            </div>
          </div>
          
          <!-- Slide 11: Contacto -->
          <div class="audit-slide" data-index="11" data-category="Contacto">
            <div class="slide-question-content">
              <div class="question-avatar-box">
                <div class="question-avatar-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                  </svg>
                </div>
              </div>
              <div class="question-texts-box">
                <h3 class="question-text">¿Tiene tu sitio accesos directos a un <span class="highlight-q-text">chat instantáneo de WhatsApp</span> o llamada inmediata?</h3>
                <p class="question-desc">Facilitar el contacto directo y veloz incrementa las consultas un 35% en pequeños negocios.</p>
              </div>
            </div>
          </div>
          
          <!-- Slide 12: Métricas -->
          <div class="audit-slide" data-index="12" data-category="Métricas">
            <div class="slide-question-content">
              <div class="question-avatar-box">
                <div class="question-avatar-circle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                  </svg>
                </div>
              </div>
              <div class="question-texts-box">
                <h3 class="question-text">¿Tienes instaladas <span class="highlight-q-text">herramientas de analítica</span> para medir de dónde vienen y qué hacen tus visitas?</h3>
                <p class="question-desc">Sin analíticas correctas, estás tomando decisiones de marketing digital a ciegas.</p>
              </div>
            </div>
          </div>
          
        </div>
      </div>

      <!-- Botones de Acción de Preguntas -->
      <div class="wizard-footer" id="wizard-controls">
        <!-- Botón Volver -->
        <button class="btn btn-secondary btn-nav-back" id="btn-back" disabled>&larr; Anterior</button>
        
        <!-- Opciones de Selección de Escala (SaaS Premium) -->
        <div class="option-buttons">
          
          <button class="btn btn-option-custom si btn-option" data-value="si">
            <span class="option-icon-circle green">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="12" height="12">
                <polyline points="20 6 9 17 4 12" />
              </svg>
            </span>
            <div class="option-text-group">
              <span class="option-title">Sí, funciona bien</span>
              <span class="option-subtitle">Mi mensaje es claro</span>
            </div>
          </button>

          <button class="btn btn-option-custom no btn-option highlighted-option" data-value="no">
            <span class="option-icon-circle orange">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="12" height="12">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </svg>
            </span>
            <div class="option-text-group">
              <span class="option-title">No, tengo problemas</span>
              <span class="option-subtitle">Necesito mejorarlo</span>
            </div>
          </button>

          <button class="btn btn-option-custom neutral btn-option" data-value="neutral">
            <span class="option-icon-circle gray">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="12" height="12">
                <circle cx="12" cy="12" r="10" />
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
              </svg>
            </span>
            <div class="option-text-group">
              <span class="option-title">No sé / A medias</span>
              <span class="option-subtitle">No estoy seguro</span>
            </div>
          </button>

        </div>
      </div>

      <!-- Pantalla de Carga Intermedia -->
      <div class="audit-loading" id="audit-loading-screen" style="display: none;">
        <div class="spinner"></div>
        <p class="loading-text">Procesando diagnóstico comercial...</p>
      </div>

      <!-- Pantalla de Resultados Parciales -->
      <div class="audit-results" id="audit-results-screen" style="display: none;">
        <div class="results-layout-two-columns">
          
          <!-- Columna Izquierda: Resultados y Análisis -->
          <div class="results-column-left">
            <!-- Tarjeta 1: Diagnóstico de Salud -->
            <div class="result-card glass-panel">
              <div class="card-badge">Métricas</div>
              <h3 class="card-title-results">Diagnóstico de Salud</h3>
              <div class="card-content-results">
                <div class="metric-block">
                  <span class="metric-label">Salud de Conversión Web</span>
                  <div class="metric-bar-container">
                    <div class="metric-bar-fill health-color" id="health-fill" style="width: 0%;"></div>
                  </div>
                  <span class="metric-value health-color" id="health-value">0%</span>
                </div>
                
                <div class="metric-block">
                  <span class="metric-label">Riesgo Estimado de Fuga</span>
                  <div class="metric-bar-container">
                    <div class="metric-bar-fill alert-color" id="fuga-fill" style="width: 0%;"></div>
                  </div>
                  <span class="metric-value alert-color" id="fuga-value">0%</span>
                </div>
              </div>
            </div>

            <!-- Tarjeta 2: Análisis de Alertas -->
            <div class="result-card glass-panel" id="analysis-card">
              <div class="card-badge warning-badge">Análisis</div>
              <h3 class="card-title-results">Impacto Estimado</h3>
              <div class="card-content-results">
                <p class="diagnostic-desc" id="diagnostic-summary">
                  Procesando...
                </p>
                <div class="alerts-detected-container" id="alerts-detected-box" style="display: none;">
                  <span class="alerts-label">Áreas críticas detectadas:</span>
                  <div class="alerts-tags-list" id="alerts-tags-list"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Columna Derecha: Slot del Formulario de Captura -->
          <div class="results-column-right">
            <slot name="capture-form" />
          </div>

        </div>
      </div>
    </div>

    <!-- Barra de Características Inferior -->
    <div class="hero-features-bar glass-panel" id="audit-features-bar">
      <div class="feature-item">
        <div class="feature-icon-box">⚡</div>
        <div class="feature-text">
          <strong class="feature-title">Rápido y sencillo</strong>
          <span class="feature-desc">Completa en solo 2 minutos y obtén tu diagnóstico.</span>
        </div>
      </div>
      <div class="feature-item">
        <div class="feature-icon-box">🎯</div>
        <div class="feature-text">
          <strong class="feature-title">Resultados inmediatos</strong>
          <span class="feature-desc">Recibe un análisis personalizado al finalizar.</span>
        </div>
      </div>
      <div class="feature-item">
        <div class="feature-icon-box">🛡️</div>
        <div class="feature-text">
          <strong class="feature-title">100% Gratis</strong>
          <span class="feature-desc">Sin tarjetas, sin trampas. Solo valor real.</span>
        </div>
      </div>
      <div class="feature-item">
        <div class="feature-icon-box">👥</div>
        <div class="feature-text">
          <strong class="feature-title">Hecho para emprendedores</strong>
          <span class="feature-desc">Entendemos tu negocio, hablamos tu idioma.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .audit-section {
    background-color: transparent;
    transition: background-color var(--transition-slow);
    position: relative;
    padding: 4.25rem 0 1rem 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Patrón de puntos de fondo decorativo */
  .dots-pattern {
    position: absolute;
    top: 10%;
    width: 250px;
    height: 80%;
    background-image: radial-gradient(rgba(245, 165, 36, 0.12) 1px, transparent 1px);
    background-size: 20px 20px;
    opacity: 0.5;
    pointer-events: none;
    z-index: -1;
  }

  .dots-pattern.left {
    left: 2rem;
  }

  .dots-pattern.right {
    right: 2rem;
  }

  /* Brillos cálidos de fondo a los lados de la tarjeta */
  .audit-glow {
    position: absolute;
    width: 450px;
    height: 450px;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: -1;
    transition: opacity var(--transition-slow);
  }

  .audit-glow.glow-left {
    top: 25%;
    left: 15%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(245, 165, 36, 0.12) 0%, transparent 70%);
  }

  .audit-glow.glow-right {
    top: 45%;
    left: 85%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(245, 165, 36, 0.08) 0%, transparent 70%);
  }

  html[data-theme="brand"] .audit-glow {
    display: none;
  }

  .back-to-top {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
