<script>
  // Control interactivo del Asistente (Wizard)
  const slides = document.querySelectorAll('.audit-slide');
  const progressFill = document.getElementById('progress-indicator');
  const stepCounter = document.getElementById('step-counter');
  const categoryText = document.getElementById('category-text');
  const btnBack = document.getElementById('btn-back') as HTMLButtonElement;
  const wizardControls = document.getElementById('wizard-controls');
  const slidesWrapper = document.getElementById('slides-wrapper');
  
  const loadingScreen = document.getElementById('audit-loading-screen');
  const resultsScreen = document.getElementById('audit-results-screen');
  const auditFeaturesBar = document.getElementById('audit-features-bar');
  
  const healthFill = document.getElementById('health-fill');
  const healthValue = document.getElementById('health-value');
  const fugaFill = document.getElementById('fuga-fill');
  const fugaValue = document.getElementById('fuga-value');
  const diagnosticSummary = document.getElementById('diagnostic-summary');

  // Campos ocultos del formulario (encontrados en la página)
  const formScoreSalud = document.getElementById('form-score-salud') as HTMLInputElement;
  const formScoreFuga = document.getElementById('form-score-fuga') as HTMLInputElement;
  const formFallasDetectadas = document.getElementById('form-fallas') as HTMLInputElement;

  let currentIdx = 0;
  const totalSteps = slides.length;
  
  // Guardar respuestas: 'si', 'no', 'neutral'
  const answers: Array<string> = [];

  // Adaptar preguntas dinámicamente para la campaña de Seguridad e IA
  const IA_QUESTIONS = [
    { category: 'Privacidad', question: '¿Utilizas la <span class="highlight-q-text">API oficial de OpenAI</span> para procesar los datos de tus clientes?', desc: 'Las cuentas gratuitas de ChatGPT usan tus datos para entrenamiento, lo que viola la privacidad empresarial.' },
    { category: 'Baneos', question: '¿Tu automatización de WhatsApp corre sobre la <span class="highlight-q-text">API Cloud oficial de Meta</span>?', desc: 'Usar pasarelas no oficiales o extensiones de Chrome provoca el baneo permanente de tu número.' },
    { category: 'Spam Legal', question: '¿Pides consentimiento explícito (<span class="highlight-q-text">Opt-in</span>) antes de enviar mensajes automatizados?', desc: 'Las leyes TCPA (EE.UU.) y CASL (Canadá) exigen consentimiento. Enviar spam tiene multas de $1,500 por mensaje.' },
    { category: 'Control Humano', question: '¿Cuenta tu bot con un <span class="highlight-q-text">semáforo de pausa</span> para detener la IA cuando un humano escribe?', desc: 'Si la IA y un humano responden al mismo tiempo, el cliente se confunde y el bot entra en bucle.' },
    { category: 'Alucinaciones', question: '¿Has configurado <span class="highlight-q-text">guardrails de seguridad</span> (límites) contra inyecciones de código o prompts?', desc: 'Sin límites, un usuario malintencionado puede forzar a tu bot a aprobar descuentos falsos o inventar servicios.' },
    { category: 'Integración', question: '¿Está el bot conectado directamente a tu <span class="highlight-q-text">Notion CRM</span> en tiempo real?', desc: 'Guardar datos en archivos locales o JSON sueltos aumenta el riesgo de pérdida y desorganización de prospectos.' },
    { category: 'Derivación', question: '¿Ofrece el bot un botón claro de <span class="highlight-q-text">salida a operador humano</span> ante preguntas complejas?', desc: 'Forzar al cliente a hablar solo con la IA arruina la experiencia de usuario y reduce las ventas.' },
    { category: 'Cifrado', question: '¿Las contraseñas y API keys están guardadas en <span class="highlight-q-text">variables de entorno seguras</span> en n8n?', desc: 'Dejar claves expuestas en los nodos del flujo es una vulnerabilidad crítica de seguridad.' },
    { category: 'Idiomas', question: '¿Tu agente de IA es <span class="highlight-q-text">bilingüe nativo</span> (español e inglés) con detección automática?', desc: 'Para el mercado de Norteamérica, responder solo en español o usar un traductor lento hace perder leads.' },
    { category: 'Tiempos', question: '¿Tiene tu bot un control de <span class="highlight-q-text">tiempo de espera</span> (timeout) para no saturar al cliente?', desc: 'Un bot que responde múltiples párrafos en milisegundos se siente artificial y molesto.' },
    { category: 'Opt-Out', question: '¿Ofreces una palabra clave de salida clara (como <span class="highlight-q-text">"STOP"</span> o "CANCELAR")?', desc: 'Es obligatorio por ley para que el usuario pueda revocar su consentimiento de recibir mensajes.' },
    { category: 'Monitoreo', question: '¿Recibes una <span class="highlight-q-text">alerta inmediata</span> en tu móvil si el bot entra en un error de ejecución?', desc: 'Si n8n falla y no te enteras, tu WhatsApp Business quedará completamente mudo.' }
  ];

  const adParam = new URLSearchParams(window.location.search).get('ad');
  if (adParam === 'seguridad-ia') {
    // Actualizar encabezados de la sección
    const auditTitleEl = document.querySelector('.audit-section .section-title');
    const auditSubtitleEl = document.querySelector('.audit-section .section-subtitle');
    if (auditTitleEl) auditTitleEl.innerHTML = 'Auto-Auditoría de <span class="italic-title">Seguridad e IA</span>';
    if (auditSubtitleEl) auditSubtitleEl.textContent = 'Descubre si tu automatización de WhatsApp cumple con la ley y está protegida contra fallos.';

    // Actualizar etiquetas en la tarjeta de resultados
    const labelHealth = document.querySelector('.metric-block:nth-of-type(1) .metric-label');
    const labelRisk = document.querySelector('.metric-block:nth-of-type(2) .metric-label');
    if (labelHealth) labelHealth.textContent = 'Salud y Compliance de la IA';
    if (labelRisk) labelRisk.textContent = 'Riesgo de Fuga / Spam';

    // Sobrescribir preguntas y categorías de los slides
    slides.forEach((slide, idx) => {
      if (IA_QUESTIONS[idx]) {
        slide.setAttribute('data-category', IA_QUESTIONS[idx].category);
        const qText = slide.querySelector('.question-text');
        const qDesc = slide.querySelector('.question-desc');
        if (qText) qText.innerHTML = IA_QUESTIONS[idx].question;
        if (qDesc) qDesc.textContent = IA_QUESTIONS[idx].desc;
      }
    });
  }

  const questionsCategories = Array.from(slides).map(s => s.getAttribute('data-category') || '');

  function updateWizard() {
    // Actualizar slides activos
    slides.forEach((slide, idx) => {
      if (idx === currentIdx) {
        slide.classList.add('active');
      } else {
        slide.classList.remove('active');
      }
    });

    // Barra de progreso y textos
    const stepNum = currentIdx + 1;
    const progressPct = (stepNum / totalSteps) * 100;
    if (progressFill) progressFill.style.width = `${progressPct}%`;
    if (stepCounter) stepCounter.textContent = `Pregunta ${stepNum} de ${totalSteps}`;
    if (categoryText) categoryText.textContent = questionsCategories[currentIdx];

    // Botón anterior
    if (btnBack) {
      btnBack.disabled = currentIdx === 0;
    }
  }

  // Escuchar clics en opciones
  const optionButtons = document.querySelectorAll('.btn-option');
  optionButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const val = (e.currentTarget as HTMLElement).getAttribute('data-value') || '';
      answers[currentIdx] = val;

      if (currentIdx < totalSteps - 1) {
        currentIdx++;
        updateWizard();
      } else {
        // Fin del cuestionario -> procesar resultados
        showLoadingAndResults();
      }
    });
  });

  // Botón atrás
  if (btnBack) {
    btnBack.addEventListener('click', () => {
      if (currentIdx > 0) {
        currentIdx--;
        updateWizard();
      }
    });
  }

  function showLoadingAndResults() {
    // Ocultar cuerpo y controles principales del wizard
    if (slidesWrapper) slidesWrapper.style.display = 'none';
    if (wizardControls) wizardControls.style.display = 'none';
    if (progressFill) progressFill.style.display = 'none';
    if (stepCounter) stepCounter.style.display = 'none';
    
    const wizardHeaderRow = document.querySelector('.wizard-header-row') as HTMLElement;
    if (wizardHeaderRow) wizardHeaderRow.style.display = 'none';
    if (auditFeaturesBar) auditFeaturesBar.style.display = 'none';

    // Remover fondo, bordes y paddings del contenedor padre del wizard
    const auditWizard = document.getElementById('audit-wizard');
    if (auditWizard) {
      auditWizard.style.background = 'transparent';
      auditWizard.style.border = 'none';
      auditWizard.style.boxShadow = 'none';
      auditWizard.style.padding = '0';
      auditWizard.style.maxWidth = '1100px';
    }

    // Ocultar los brillos de fondo y patrones de puntos en modo resultados
    const auditGlows = document.querySelectorAll('.audit-glow');
    const dotsPatterns = document.querySelectorAll('.dots-pattern');
    auditGlows.forEach((glow: any) => glow.style.display = 'none');
    dotsPatterns.forEach((dot: any) => dot.style.display = 'none');

    // Mostrar pantalla de carga
    if (loadingScreen) loadingScreen.style.display = 'flex';

    setTimeout(() => {
      // Ocultar carga y mostrar resultados
      if (loadingScreen) loadingScreen.style.display = 'none';
      if (resultsScreen) resultsScreen.style.display = 'block';

      calculateMetrics();
    }, 1500); // 1.5s de delay simulado para generar expectativa
  }

  function calculateMetrics() {
    let yesCount = 0;
    let noCount = 0;
    let neutralCount = 0;
    const alertList: Array<string> = [];

    answers.forEach((ans, idx) => {
      if (ans === 'si') {
        yesCount++;
      } else if (ans === 'no') {
        noCount++;
        alertList.push(questionsCategories[idx]);
      } else {
        neutralCount++;
        alertList.push(`${questionsCategories[idx]} (Inseguro)`);
      }
    });

    // Score Salud de Conversión = (Sí / 12) * 100
    const healthScore = Math.round((yesCount / totalSteps) * 100);

    // Tasa de Fuga = 15% base + (Alertas * 6.6%), tope de 95%
    const alertsCount = noCount + neutralCount;
    const fugaRate = Math.min(15 + Math.round(alertsCount * 6.6), 95);

    // Escribir en pantalla animando las barras
    setTimeout(() => {
      if (healthFill) healthFill.style.width = `${healthScore}%`;
      if (healthValue) healthValue.textContent = `${healthScore}%`;
      if (fugaFill) fugaFill.style.width = `${fugaRate}%`;
      if (fugaValue) fugaValue.textContent = `${fugaRate}%`;
    }, 100);

    // Texto de diagnóstico y escritura en campos ocultos
    let summary = '';
    if (adParam === 'seguridad-ia') {
      if (healthScore < 50) {
        summary = `⚠️ Riesgo Crítico de Bloqueo o Multa. Tu arquitectura de WhatsApp IA muestra graves fallos de seguridad y compliance. Estimamos un alto riesgo de baneo de número por Meta o multas de hasta $1,500/mensaje por spam (TCPA/CASL).`;
      } else if (healthScore <= 80) {
        summary = `⚠️ Vulnerabilidad de Datos / Control. Tienes bases correctas, pero tu flujo n8n carece de controles críticos (como la pausa humana o la prevención de alucinaciones) que podrían molestar a tus clientes o exponer tu base de datos.`;
      } else {
        summary = `✅ Arquitectura Segura. Tu configuración de WhatsApp e IA cumple con las mejores prácticas de privacidad y leyes de Norteamérica. Tienes un riesgo muy bajo de fallos o bloqueos.`;
      }
    } else {
      if (healthScore < 50) {
        summary = `⚠️ Alerta de Fuga Crítica. Tu marca y tu web muestran debilidades críticas en conversión y velocidad. Estimamos un riesgo potencial de fuga de hasta el ${fugaRate}% de tus clientes potenciales antes de que logren contactarte.`;
      } else if (healthScore <= 80) {
        summary = `⚠️ Pérdida Silenciosa de Ventas. Tienes bases razonables, pero existen problemas específicos de conversión que podrían poner en riesgo de fuga a cerca del ${fugaRate}% de tus visitas diarias.`;
      } else {
        summary = `✅ Estado Saludable. Tienes una web y marca sólidas. Sin embargo, persisten pequeños detalles técnicos y de copy que causan un riesgo de fuga de hasta el ${fugaRate}% de tus prospectos potenciales actuales.`;
      }
    }

    if (diagnosticSummary) diagnosticSummary.textContent = summary;

    // Inyectar tags de alertas detectadas en la tarjeta central de Análisis
    const alertsTagsList = document.getElementById('alerts-tags-list');
    const alertsDetectedBox = document.getElementById('alerts-detected-box');
    if (alertsTagsList && alertsDetectedBox) {
      alertsTagsList.innerHTML = '';
      if (alertList.length > 0) {
        alertsDetectedBox.style.display = 'block';
        alertList.forEach(alertCategory => {
          const tag = document.createElement('span');
          tag.className = 'alert-tag';
          tag.textContent = alertCategory.replace(' (Inseguro)', '');
          alertsTagsList.appendChild(tag);
        });
      } else {
        alertsDetectedBox.style.display = 'none';
      }
    }

    // Sincronizar con el formulario oculto de Web3Forms
    if (formScoreSalud) formScoreSalud.value = `${healthScore}%`;
    if (formScoreFuga) formScoreFuga.value = `${fugaRate}%`;
    if (formFallasDetectadas) formFallasDetectadas.value = alertList.join(', ');
  }
</script>
