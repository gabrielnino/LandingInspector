---
// src/components/features/landing/comp-audit-tool.astro
---
<section id="audit" class="snap-section audit-section">
  <a href="#top" class="back-to-top" aria-label="Volver al inicio" title="Volver al inicio">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m18 15-6-6-6 6"></path>
    </svg>
  </a>

  <div class="container audit-container">
    <div class="section-header text-center">
      <h2 class="section-title">Auto-Auditoría de Conversión</h2>
      <p class="section-subtitle">Descubre el estado de tu negocio digital en 12 preguntas interactivas.</p>
    </div>

    <!-- Wizard de Auto-Auditoría -->
    <div class="audit-card glass-panel" id="audit-wizard">
      <!-- Barra de progreso -->
      <div class="wizard-progress-bar">
        <div class="progress-fill" id="progress-indicator" style="width: 8.33%;"></div>
      </div>
      
      <div class="wizard-header">
        <span class="step-counter" id="step-counter">Pregunta 1 de 12</span>
        <span class="category-badge" id="category-badge">Claridad</span>
      </div>

      <!-- Preguntas del Wizard -->
      <div class="wizard-body">
        <div class="slide-container" id="slides-wrapper">
          <!-- Slide 1 -->
          <div class="audit-slide active" data-index="1" data-category="Claridad">
            <h3 class="question-text">¿Tus visitas entienden claramente qué vendes y a quién ayudas en los primeros 5 segundos de entrar a tu web?</h3>
            <p class="question-desc">Una propuesta de valor confusa es la causa número uno de rebote inmediato.</p>
          </div>
          <!-- Slide 2 -->
          <div class="audit-slide" data-index="2" data-category="Confianza">
            <h3 class="question-text">¿Tu sitio muestra testimonios creíbles de clientes reales, con nombres, fotos o enlaces verificables?</h3>
            <p class="question-desc">Sin pruebas sociales reales, las visitas perciben tu sitio como genérico o inseguro.</p>
          </div>
          <!-- Slide 3 -->
          <div class="audit-slide" data-index="3" data-category="Conversión">
            <h3 class="question-text">¿Tus llamadas a la acción (CTAs) son claras, visibles y orientadas al beneficio (ej: "Pedir diagnóstico gratis" en vez de "Enviar")?</h3>
            <p class="question-desc">Botones apagados o confusos reducen la tasa de clics a menos de la mitad.</p>
          </div>
          <!-- Slide 4 -->
          <div class="audit-slide" data-index="4" data-category="Diseño">
            <h3 class="question-text">¿El logotipo y el diseño visual de tu marca se ven profesionales, consistentes y adaptados a tu industria?</h3>
            <p class="question-desc">Un logotipo amateur hecho con plantillas de $5 resta autoridad frente a competidores establecidos.</p>
          </div>
          <!-- Slide 5 -->
          <div class="audit-slide" data-index="5" data-category="Técnico">
            <h3 class="question-text">¿Tu sitio web se carga completamente en menos de 3 segundos en cualquier conexión estándar?</h3>
            <p class="question-desc">El 53% de los usuarios móviles abandona una página si esta tarda más de 3 segundos en cargar.</p>
          </div>
          <!-- Slide 6 -->
          <div class="audit-slide" data-index="6" data-category="Móvil">
            <h3 class="question-text">¿Tu página se visualiza perfectamente en teléfonos celulares sin textos superpuestos o scrolls horizontales incómodos?</h3>
            <p class="question-desc">Más del 60% de tus clientes potenciales te buscarán desde sus dispositivos móviles.</p>
          </div>
          <!-- Slide 7 -->
          <div class="audit-slide" data-index="7" data-category="Captura">
            <h3 class="question-text">¿Tus formularios de contacto son cortos y rápidos de llenar, pidiendo únicamente la información esencial?</h3>
            <p class="question-desc">Formularios con más de 4 campos innecesarios ahuyentan a posibles leads interesados.</p>
          </div>
          <!-- Slide 8 -->
          <div class="audit-slide" data-index="8" data-category="Copywriting">
            <h3 class="question-text">¿Los textos de tu web se enfocan en resolver los dolores de tu cliente en lugar de hablar solo de tus logros (egocentrismo)?</h3>
            <p class="question-desc">El cliente compra soluciones a sus propios problemas, no tu historia corporativa.</p>
          </div>
          <!-- Slide 9 -->
          <div class="audit-slide" data-index="9" data-category="SEO">
            <h3 class="question-text">¿Aparece tu negocio en la primera página de Google o en Google Maps cuando tus clientes buscan tu servicio en tu ciudad?</h3>
            <p class="question-desc">Si no estás en la primera página de resultados, eres prácticamente invisible orgánicamente.</p>
          </div>
          <!-- Slide 10 -->
          <div class="audit-slide" data-index="10" data-category="Seguridad">
            <h3 class="question-text">¿Tu web cuenta con protocolo HTTPS activo (el candado de seguridad en la barra de direcciones)?</h3>
            <p class="question-desc">Los navegadores advierten activamente a los usuarios de "Sitio no seguro", destruyendo la confianza.</p>
          </div>
          <!-- Slide 11 -->
          <div class="audit-slide" data-index="11" data-category="Contacto">
            <h3 class="question-text">¿Tiene tu sitio botones de acceso rápido y directo a un chat instantáneo de WhatsApp o llamada telefónica?</h3>
            <p class="question-desc">Facilitar el contacto directo y veloz incrementa las consultas un 35% en pequeños negocios.</p>
          </div>
          <!-- Slide 12 -->
          <div class="audit-slide" data-index="12" data-category="Métricas">
            <h3 class="question-text">¿Tienes instaladas herramientas de analítica y píxeles (Meta/Google Analytics) para registrar de dónde vienen tus visitas?</h3>
            <p class="question-desc">Sin analíticas correctas, estás tomando decisiones a ciegas en tu negocio digital.</p>
          </div>
        </div>
      </div>

      <!-- Botones de Acción de Preguntas -->
      <div class="wizard-footer" id="wizard-controls">
        <button class="btn btn-secondary btn-nav-back" id="btn-back" disabled>&larr; Anterior</button>
        <div class="option-buttons">
          <button class="btn btn-secondary btn-option" data-value="si">Sí, funciona bien</button>
          <button class="btn btn-primary btn-option" data-value="no">No, tengo problemas</button>
          <button class="btn btn-secondary btn-option btn-neutral" data-value="neutral">No sé / A medias</button>
        </div>
      </div>

      <!-- Pantalla de Carga Intermedia -->
      <div class="audit-loading" id="audit-loading-screen" style="display: none;">
        <div class="spinner"></div>
        <p class="loading-text">Procesando diagnóstico comercial...</p>
      </div>

      <!-- Pantalla de Resultados Parciales -->
      <div class="audit-results" id="audit-results-screen" style="display: none;">
        <div class="results-layout">
          <div class="results-stats">
            <h3 class="results-headline">Diagnóstico Preliminar</h3>
            
            <div class="metric-block">
              <span class="metric-label">Riesgo Estimado de Fuga de Prospectos</span>
              <div class="metric-bar-container">
                <div class="metric-bar-fill alert-color" id="fuga-fill" style="width: 0%;"></div>
              </div>
              <span class="metric-value alert-color" id="fuga-value">0%</span>
            </div>

            <div class="metric-block">
              <span class="metric-label">Salud de Conversión Web</span>
              <div class="metric-bar-container">
                <div class="metric-bar-fill health-color" id="health-fill" style="width: 0%;"></div>
              </div>
              <span class="metric-value health-color" id="health-value">0%</span>
            </div>

            <p class="diagnostic-desc" id="diagnostic-summary">
              Procesando...
            </p>
          </div>
          
          <div class="results-unlock-box">
            <h4 class="unlock-title">🔓 Desbloquear Diagnóstico Completo</h4>
            <p class="unlock-subtitle">Déjame tus datos para enviarte un análisis detallado punto por punto y una recomendación accionable de regalo hecha a mano para tu negocio.</p>
            <slot name="capture-form" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .audit-section {
    background-color: var(--color-bg-secondary);
    transition: background-color var(--transition-slow);
    position: relative;
  }

  .back-to-top {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .back-to-top:hover {
    background-color: var(--color-card-hover);
    border-color: var(--color-accent-primary);
  }

  .audit-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    width: 100%;
  }

  .section-header {
    max-width: 600px;
  }

  .section-title {
    font-size: 2.25rem;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    color: var(--color-text-secondary);
    font-size: 1rem;
  }

  .audit-card {
    width: 100%;
    max-width: 900px;
    min-height: 400px;
    padding: 1.75rem 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  .wizard-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 6px;
    background-color: var(--color-border);
  }

  .progress-fill {
    height: 100%;
    background-color: var(--color-accent-primary);
    transition: width var(--transition-fast) ease-in-out;
  }

  .wizard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
  }

  .step-counter {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .category-badge {
    background-color: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 50px;
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-transform: uppercase;
  }

  .wizard-body {
    flex-grow: 1;
    display: flex;
    align-items: center;
    min-height: 180px;
    position: relative;
  }

  .slide-container {
    width: 100%;
    position: relative;
  }

  .audit-slide {
    display: none;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity var(--transition-fast) ease-out, transform var(--transition-fast) ease-out;
    width: 100%;
  }

  .audit-slide.active {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .question-text {
    font-size: 1.5rem;
    font-family: var(--font-title);
    margin-bottom: 1rem;
    color: var(--color-text-primary);
    line-height: 1.35;
  }

  .question-desc {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .wizard-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
    margin-top: 2rem;
    gap: 1rem;
  }

  .option-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-nav-back {
    padding: 0.6rem 1.2rem;
    font-size: 0.85rem;
  }

  .btn-option {
    padding: 0.75rem 1.5rem;
    font-size: 0.9rem;
  }

  .btn-neutral {
    background-color: transparent;
    border-color: var(--color-border);
    color: var(--color-text-secondary);
  }

  .btn-neutral:hover {
    border-color: var(--color-text-muted);
    background-color: var(--color-bg-tertiary);
  }

  /* Pantalla de Carga */
  .audit-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    gap: 1.5rem;
    min-height: 250px;
  }

  .spinner {
    width: 50px;
    height: 50px;
    border: 5px solid var(--color-border);
    border-top-color: var(--color-accent-primary);
    border-radius: 50%;
    animation: spin 1s infinite linear;
  }

  .loading-text {
    font-weight: 600;
    color: var(--color-text-secondary);
    font-family: var(--font-title);
  }

  /* Pantalla de Resultados */
  .audit-results {
    width: 100%;
    animation: fadeIn var(--transition-fast) ease-out;
  }

  .results-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
  }

  .results-stats {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .results-headline {
    font-size: 1.5rem;
    font-family: var(--font-title);
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .metric-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .metric-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .metric-bar-container {
    width: 100%;
    height: 10px;
    background-color: var(--color-border);
    border-radius: 5px;
    overflow: hidden;
  }

  .metric-bar-fill {
    height: 100%;
    border-radius: 5px;
    transition: width 1s cubic-bezier(0.1, 0.8, 0.2, 1);
  }

  .alert-color {
    background-color: var(--color-accent-secondary);
    color: var(--color-accent-secondary);
  }

  .health-color {
    background-color: #2ec4b6; /* Teal green for health */
    color: #2ec4b6;
  }

  :global([data-theme="brand"]) .health-color {
    background-color: #122c54;
    color: #122c54;
  }

  .metric-value {
    font-size: 1.5rem;
    font-weight: 800;
    font-family: var(--font-title);
    line-height: 1;
  }

  .diagnostic-desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    border-left: 3px solid var(--color-accent-primary);
    padding-left: 1rem;
    line-height: 1.5;
  }

  .results-unlock-box {
    padding: 1.5rem;
    background-color: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .unlock-title {
    font-size: 1.15rem;
    font-family: var(--font-title);
    color: var(--color-text-primary);
  }

  .unlock-subtitle {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .results-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .wizard-footer {
      flex-direction: column-reverse;
      align-items: stretch;
    }
    .option-buttons {
      flex-direction: column;
    }
    .btn-option {
      width: 100%;
    }
    .back-to-top {
      top: 1rem;
      right: 1rem;
    }
  }
</style>

<script>
  // Control interactivo del Asistente (Wizard)
  const slides = document.querySelectorAll('.audit-slide');
  const progressFill = document.getElementById('progress-indicator');
  const stepCounter = document.getElementById('step-counter');
  const categoryBadge = document.getElementById('category-badge');
  const btnBack = document.getElementById('btn-back') as HTMLButtonElement;
  const wizardControls = document.getElementById('wizard-controls');
  const slidesWrapper = document.getElementById('slides-wrapper');
  
  const loadingScreen = document.getElementById('audit-loading-screen');
  const resultsScreen = document.getElementById('audit-results-screen');
  
  const healthFill = document.getElementById('health-fill');
  const healthValue = document.getElementById('health-value');
  const fugaFill = document.getElementById('fuga-fill');
  const fugaValue = document.getElementById('fuga-value');
  const diagnosticSummary = document.getElementById('diagnostic-summary');

  // Campos ocultos del formulario (encontrados en la página)
  const formScoreSalud = document.getElementById('form-score-salud') as HTMLInputElement;
  const formScoreFuga = document.getElementById('form-score-fuga') as HTMLInputElement;
  const formFallasDetectadas = document.getElementById('form-fallas') as HTMLInputElement;

  let currentIdx = 0;
  const totalSteps = slides.length;
  
  // Guardar respuestas: 'si', 'no', 'neutral'
  const answers: Array<string> = [];
  const questionsCategories = Array.from(slides).map(s => s.getAttribute('data-category') || '');
  const questionsTexts = Array.from(slides).map(s => s.querySelector('.question-text')?.textContent || '');

  function updateWizard() {
    // Actualizar slides activos
    slides.forEach((slide, idx) => {
      if (idx === currentIdx) {
        slide.classList.add('active');
      } else {
        slide.classList.remove('active');
      }
    });

    // Barra de progreso y textos
    const stepNum = currentIdx + 1;
    const progressPct = (stepNum / totalSteps) * 100;
    if (progressFill) progressFill.style.width = `${progressPct}%`;
    if (stepCounter) stepCounter.textContent = `Pregunta ${stepNum} de ${totalSteps}`;
    if (categoryBadge) categoryBadge.textContent = questionsCategories[currentIdx];

    // Botón anterior
    if (btnBack) {
      btnBack.disabled = currentIdx === 0;
    }
  }

  // Escuchar clics en opciones
  const optionButtons = document.querySelectorAll('.btn-option');
  optionButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const val = (e.currentTarget as HTMLElement).getAttribute('data-value') || '';
      answers[currentIdx] = val;

      if (currentIdx < totalSteps - 1) {
        currentIdx++;
        updateWizard();
      } else {
        // Fin del cuestionario -> procesar resultados
        showLoadingAndResults();
      }
    });
  });

  // Botón atrás
  if (btnBack) {
    btnBack.addEventListener('click', () => {
      if (currentIdx > 0) {
        currentIdx--;
        updateWizard();
      }
    });
  }

  function showLoadingAndResults() {
    // Ocultar cuerpo y controles principales del wizard
    if (slidesWrapper) slidesWrapper.style.display = 'none';
    if (wizardControls) wizardControls.style.display = 'none';
    if (progressFill) progressFill.style.display = 'none';
    if (stepCounter) stepCounter.style.display = 'none';
    if (categoryBadge) categoryBadge.style.display = 'none';

    // Ocultar cabecera vacía, cuerpo del wizard y barra de progreso para eliminar espacio en blanco
    const wizardHeader = document.querySelector('.wizard-header') as HTMLElement;
    const wizardBody = document.querySelector('.wizard-body') as HTMLElement;
    const progressBar = document.querySelector('.wizard-progress-bar') as HTMLElement;
    
    if (wizardHeader) wizardHeader.style.display = 'none';
    if (wizardBody) wizardBody.style.display = 'none';
    if (progressBar) progressBar.style.display = 'none';

    // Mostrar pantalla de carga
    if (loadingScreen) loadingScreen.style.display = 'flex';

    setTimeout(() => {
      // Ocultar carga y mostrar resultados
      if (loadingScreen) loadingScreen.style.display = 'none';
      if (resultsScreen) resultsScreen.style.display = 'block';

      calculateMetrics();
    }, 1500); // 1.5s de delay simulado para generar expectativa
  }

  function calculateMetrics() {
    let yesCount = 0;
    let noCount = 0;
    let neutralCount = 0;
    const alertList: Array<string> = [];

    answers.forEach((ans, idx) => {
      if (ans === 'si') {
        yesCount++;
      } else if (ans === 'no') {
        noCount++;
        alertList.push(questionsCategories[idx]);
      } else {
        neutralCount++;
        alertList.push(`${questionsCategories[idx]} (Inseguro)`);
      }
    });

    // Score Salud de Conversión = (Sí / 12) * 100
    const healthScore = Math.round((yesCount / totalSteps) * 100);

    // Tasa de Fuga = 15% base + (Alertas * 6.6%), tope de 95%
    const alertsCount = noCount + neutralCount;
    const fugaRate = Math.min(15 + Math.round(alertsCount * 6.6), 95);

    // Escribir en pantalla animando las barras
    setTimeout(() => {
      if (healthFill) healthFill.style.width = `${healthScore}%`;
      if (healthValue) healthValue.textContent = `${healthScore}%`;
      if (fugaFill) fugaFill.style.width = `${fugaRate}%`;
      if (fugaValue) fugaValue.textContent = `${fugaRate}%`;
    }, 100);

    // Texto de diagnóstico y escritura en campos ocultos
    let summary = '';
    if (healthScore < 50) {
      summary = `⚠️ Alerta de Fuga Crítica. Tu marca y tu web muestran debilidades críticas en conversión y velocidad. Estimamos un riesgo potencial de fuga de hasta el ${fugaRate}% de tus clientes potenciales antes de que logren contactarte.`;
    } else if (healthScore <= 80) {
      summary = `⚠️ Pérdida Silenciosa de Ventas. Tienes bases razonables, pero existen problemas específicos de conversión que podrían poner en riesgo de fuga a cerca del ${fugaRate}% de tus visitas diarias.`;
    } else {
      summary = `✅ Estado Saludable. Tienes una web y marca sólidas. Sin embargo, persisten pequeños detalles técnicos y de copy que causan un riesgo de fuga de hasta el ${fugaRate}% de tus prospectos potenciales actuales.`;
    }

    if (diagnosticSummary) diagnosticSummary.textContent = summary;

    // Sincronizar con el formulario oculto de Web3Forms
    if (formScoreSalud) formScoreSalud.value = `${healthScore}%`;
    if (formScoreFuga) formScoreFuga.value = `${fugaRate}%`;
    if (formFallasDetectadas) formFallasDetectadas.value = alertList.join(', ');
  }
</script>
