---
// src/components/features/landing/comp-audit-form.astro
// Web3Forms Access Key: Carga desde variable de entorno o fallback local
const ACCESS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY || "";
---
<form action="https://api.web3forms.com/submit" method="POST" class="audit-capture-form-two-cards" id="contact-form">
  <!-- Web3Forms Config -->
  <input type="hidden" name="access_key" value={ACCESS_KEY} />
  <input type="hidden" name="subject" value="Nueva Auditoría Solicitada - LandingInspector" />
  <input type="hidden" name="from_name" value="LandingInspector Auditorías" />
  
  <!-- Inputs Ocultos de Diagnóstico (Inyectados por el Wizard) -->
  <input type="hidden" name="salud_conversion" id="form-score-salud" value="No completada" />
  <input type="hidden" name="tasa_fuga_estimada" id="form-score-fuga" value="No completada" />
  <input type="hidden" name="fallas_detectadas" id="form-fallas" value="Ninguna" />

  <!-- Atribución de campaña (rellenados por JS desde la URL / sessionStorage) -->
  <input type="hidden" name="ad" id="form-ad" value="" />
  <input type="hidden" name="utm_source" id="form-utm-source" value="" />
  <input type="hidden" name="utm_campaign" id="form-utm-campaign" value="" />
  <input type="hidden" name="utm_content" id="form-utm-content" value="" />

  <!-- Tarjeta A: Datos de Contacto (Paso 1) -->
  <div class="form-card-part glass-panel" id="form-step-1">
    <div class="card-badge">Paso 1 de 2</div>
    <h3 class="card-title-form">Tus Datos de Contacto</h3>
    <div class="form-card-content">
      <div class="form-group">
        <label for="client-name" class="form-label">Tu Nombre</label>
        <input type="text" name="name" id="client-name" class="form-input" placeholder="Ej: Luis Gabriel" required />
      </div>

      <div class="form-group">
        <label for="client-email" class="form-label">Tu Email de Trabajo</label>
        <input type="email" name="email" id="client-email" class="form-input" placeholder="Ej: contacto@tudominio.com" required />
      </div>

      <div class="form-group">
        <label for="client-phone" class="form-label">WhatsApp / Teléfono <span class="muted-label">(Opcional)</span></label>
        <input type="tel" name="phone" id="client-phone" class="form-input" placeholder="Ej: +1 (604) 555-0199" />
      </div>

      <div class="form-group">
        <label for="client-website" class="form-label">Tu Web o Red Principal</label>
        <input type="url" name="website" id="client-website" class="form-input" placeholder="Ej: https://tudominio.com" required />
      </div>
      
      <div class="form-step-controls">
        <button type="button" class="btn btn-primary btn-next-step" id="btn-form-next">
          Siguiente paso &rarr;
        </button>
      </div>
    </div>
  </div>

  <!-- Tarjeta B: Detalles & Envío (Paso 2) -->
  <div class="form-card-part glass-panel highlighted-form-card" id="form-step-2" style="display: none;">
    <div class="card-badge action-badge">Paso 2 de 2</div>
    <h3 class="card-title-form">Detalles de tu Negocio</h3>
    <div class="form-card-content">
      <div class="form-group">
        <label for="client-message" class="form-label">¿Qué te gustaría mejorar en tu negocio? <span class="muted-label">(Opcional)</span></label>
        <textarea name="message" id="client-message" class="form-textarea" rows="4" placeholder="Ej: Quiero vender más servicios en Vancouver..."></textarea>
      </div>

      <p class="form-agenda-notice">
        ⚠️ <strong>Cupo limitado:</strong> Luis realiza un máximo de 5 auditorías personalizadas en video por semana para garantizar calidad de nivel senior.
      </p>

      <div class="form-step-controls dual-controls">
        <button type="button" class="btn btn-secondary btn-prev-step" id="btn-form-prev">
          &larr; Volver
        </button>
        <button type="submit" class="btn btn-primary btn-submit">
          Pedir auditoría &rarr;
        </button>
      </div>

      <p class="form-security-note">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
          <path fill-rule="evenodd" d="M2.166 4.9c0-.76.37-1.46 1.02-1.87A13.064 13.064 0 0110 1.22c3.19 0 6.14.73 8.813 2.05.65.41 1.02 1.12 1.02 1.87V10c0 5.002-4.086 9.11-9.103 9.87a1 1 0 01-.164 0C5.402 19.11 1.316 15 1.316 10V4.9zM10 5a1 1 0 00-.707.293l-3 3a1 1 0 001.414 1.414L9 7.414V13a1 1 0 102 0V7.414l1.293 1.293a1 1 0 001.414-1.414l-3-3A1 1 0 0010 5z" clip-rule="evenodd" />
        </svg>
        Confidencialidad absoluta bajo NDAs. Cero Spam.
      </p>
    </div>
  </div>

  <!-- Tarjeta C: Confirmación de Éxito (Paso 3) -->
  <div class="form-card-part glass-panel highlighted-form-card" id="form-success" style="display: none;">
    <div class="card-badge action-badge" style="border-color: rgba(46, 196, 182, 0.3); color: #2ec4b6; background-color: rgba(46, 196, 182, 0.05);">¡Completado!</div>
    <h3 class="card-title-form">¡Diagnóstico Solicitado!</h3>
    <div class="form-card-content success-card-content">
      <div class="success-icon-large">🎉</div>
      <p class="success-main-text">He recibido tus datos y tu score de conversión correctamente.</p>
      <p class="success-sub-text">
        Analizaré tu página web punto por punto y te enviaré un <strong>video diagnóstico hecho a mano</strong> en las próximas 48 horas.
      </p>
      <div class="success-actions">
        <a href="#top" class="btn btn-secondary btn-success-back">
          Volver al inicio
        </a>
      </div>
    </div>
  </div>
</form>

<style>
  .audit-capture-form-two-cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    height: 100%;
  }

  .form-card-part {
    display: none;
    flex-direction: column;
    padding: 2.25rem 1.75rem;
    border-radius: 12px;
    position: relative;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  /* Mostrar la tarjeta activa en flex */
  .form-card-part#form-step-1 {
    display: flex;
  }

  .form-card-part:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-primary);
  }

  .highlighted-form-card {
    border-color: var(--color-accent-primary);
    box-shadow: 0 8px 30px rgba(245, 165, 36, 0.08);
  }

  .card-badge {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background-color: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .action-badge {
    border-color: rgba(46, 196, 182, 0.3);
    color: #2ec4b6;
    background-color: rgba(46, 196, 182, 0.05);
  }

  .card-title-form {
    font-size: 1.25rem;
    font-family: var(--font-title);
    margin-bottom: 1.5rem;
    color: var(--color-text-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
    font-weight: 700;
  }

  .form-card-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex-grow: 1;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: left;
  }

  .form-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .muted-label {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .form-input, .form-textarea {
    width: 100%;
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.55rem 0.75rem;
    color: var(--color-text-primary);
    font-size: 0.85rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 0 3px var(--color-border-focus);
  }

  .form-textarea {
    resize: vertical;
  }

  .form-agenda-notice {
    font-size: 0.725rem;
    background-color: rgba(245, 165, 36, 0.06);
    border: 1px solid rgba(245, 165, 36, 0.15);
    color: var(--color-text-secondary);
    padding: 0.45rem 0.7rem;
    border-radius: 6px;
    line-height: 1.4;
    margin: 0.15rem 0;
  }

  .form-step-controls {
    display: flex;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .dual-controls {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .btn-next-step, .btn-prev-step {
    padding: 0.65rem 1.25rem;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .btn-submit {
    flex-grow: 1;
    margin-top: 0;
    padding: 0.65rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .form-security-note {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    line-height: 1.3;
    margin-top: 0.25rem;
  }

  .form-security-note svg {
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  /* Estilos del estado de éxito */
  .success-card-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding: 1rem 0;
  }

  .success-icon-large {
    font-size: 3rem;
    animation: bounce 2s infinite;
  }

  .success-main-text {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .success-sub-text {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .success-actions {
    margin-top: 1rem;
    width: 100%;
  }

  .btn-success-back {
    width: 100%;
    justify-content: center;
    padding: 0.65rem;
    font-size: 0.85rem;
    font-weight: 700;
  }

  /* Animación de rebote */
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  /* Estilos de validación e inline spinner */
  .form-input.is-invalid, .form-textarea.is-invalid {
    border-color: #ff0055;
    box-shadow: 0 0 0 3px rgba(255, 0, 85, 0.15);
  }

  .spinner-inline {
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 2px solid rgba(255,255,255,0.3);
    border-radius: 50%;
    border-top-color: #fff;
    animation: spin 0.8s linear infinite;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const formStep1 = document.getElementById('form-step-1');
  const formStep2 = document.getElementById('form-step-2');
  const formSuccess = document.getElementById('form-success');
  const btnFormNext = document.getElementById('btn-form-next');
  const btnFormPrev = document.getElementById('btn-form-prev');
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btnSubmit = form?.querySelector('.btn-submit') as HTMLButtonElement;
  
  // Campos del formulario a validar
  const inputName = document.getElementById('client-name') as HTMLInputElement;
  const inputEmail = document.getElementById('client-email') as HTMLInputElement;
  const inputWebsite = document.getElementById('client-website') as HTMLInputElement;

  const inputs = [inputName, inputEmail, inputWebsite];

  // Modificar textos si ad=seguridad-ia
  const adParam = new URLSearchParams(window.location.search).get('ad');
  if (adParam === 'seguridad-ia') {
    const successTitle = document.querySelector('#form-success .card-title-form');
    const successMain = document.querySelector('#form-success .success-main-text');
    const successSub = document.querySelector('#form-success .success-sub-text');
    if (successTitle) successTitle.textContent = '¡Diagnóstico y Plantilla Solicitados!';
    if (successMain) successMain.innerHTML = 'He recibido tus datos y tus respuestas del diagnóstico correctamente.';
    if (successSub) successSub.innerHTML = 'Te enviaré la <strong>plantilla de n8n</strong> por correo de inmediato, y revisaré tu canal de WhatsApp para alertarte de posibles fugas de datos en las próximas 48 horas.';
  }

  // --- Atribución: leer ?ad y UTMs de la URL (o sessionStorage) y volcarlos a los campos ocultos ---
  (function () {
    try {
      const params = new URLSearchParams(window.location.search);
      const keys = ['ad', 'utm_source', 'utm_campaign', 'utm_content'];
      keys.forEach((k) => {
        const stored = sessionStorage.getItem('attr_' + k) || '';
        const v = params.get(k) || stored || '';
        if (v) sessionStorage.setItem('attr_' + k, v);
        const el = document.getElementById('form-' + k.replace('utm_', 'utm-')) as HTMLInputElement | null;
        if (el) el.value = v;
      });
    } catch (e) { /* atribución best-effort */ }
  })();

  // Limpiar error al escribir
  inputs.forEach(input => {
    input.addEventListener('input', () => {
      input.classList.remove('is-invalid');
    });
  });

  if (btnFormNext && formStep1 && formStep2) {
    btnFormNext.addEventListener('click', () => {
      let hasError = false;
      inputs.forEach(input => {
        if (!input.checkValidity()) {
          input.classList.add('is-invalid');
          hasError = true;
        } else {
          input.classList.remove('is-invalid');
        }
      });

      if (!hasError) {
        // Ocultar paso 1 y mostrar paso 2 con animación
        formStep1.style.display = 'none';
        formStep2.style.display = 'flex';
        formStep2.style.animation = 'fadeIn var(--transition-fast) ease-out';
      } else {
        // Reportar los errores de validación
        const firstInvalid = inputs.find(input => !input.checkValidity());
        if (firstInvalid) firstInvalid.reportValidity();
      }
    });
  }

  if (btnFormPrev && formStep1 && formStep2) {
    btnFormPrev.addEventListener('click', () => {
      // Volver al paso 1
      formStep2.style.display = 'none';
      formStep1.style.display = 'flex';
      formStep1.style.animation = 'fadeIn var(--transition-fast) ease-out';
    });
  }

  // Envío asíncrono (AJAX) para evitar redirecciones de Web3Forms
  if (form && formStep2 && formSuccess) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Validación previa al envío
      const isNameValid = inputName.checkValidity();
      const isEmailValid = inputEmail.checkValidity();
      const isWebsiteValid = inputWebsite.checkValidity();
      
      if (!isNameValid || !isEmailValid || !isWebsiteValid) {
        formStep2.style.display = 'none';
        formStep1.style.display = 'flex';
        if (!isNameValid) {
          inputName.classList.add('is-invalid');
          inputName.reportValidity();
        } else if (!isEmailValid) {
          inputEmail.classList.add('is-invalid');
          inputEmail.reportValidity();
        } else if (!isWebsiteValid) {
          inputWebsite.classList.add('is-invalid');
          inputWebsite.reportValidity();
        }
        return;
      }
      
      // Cambiar estado del botón a cargando
      if (btnSubmit) {
        btnSubmit.disabled = true;
        btnSubmit.innerHTML = 'Enviando... <span class="spinner-inline"></span>';
      }
      
      const formData = new FormData(form);
      
      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });
        
        if (response.ok) {
          // Meta Pixel: registrar el Lead con la atribución del anuncio
          try {
            const _ad = (document.getElementById('form-ad') as HTMLInputElement | null)?.value || '';
            (window as any).fbq && (window as any).fbq('track', 'Lead', { content_name: _ad || 'sin_ad' });
          } catch (e) { /* pixel best-effort */ }

          // Éxito: ocultar paso 2 y mostrar tarjeta de éxito
          formStep2.style.display = 'none';
          formSuccess.style.display = 'flex';
          formSuccess.style.animation = 'fadeIn var(--transition-fast) ease-out';
          
          form.reset();
        } else {
          alert('Hubo un problema al enviar el formulario. Por favor, inténtalo de nuevo.');
          if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = 'Pedir auditoría &rarr;';
          }
        }
      } catch (error) {
        console.error(error);
        alert('Error de conexión. Por favor, revisa tu conexión a internet.');
        if (btnSubmit) {
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = 'Pedir auditoría &rarr;';
        }
      }
    });
  }
</script>
