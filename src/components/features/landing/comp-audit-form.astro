---
// src/components/features/landing/comp-audit-form.astro
// Web3Forms Access Key: Reemplazar con clave de producción
const ACCESS_KEY = "YOUR_WEB3FORMS_ACCESS_KEY_HERE";
---
<form action="https://api.web3forms.com/submit" method="POST" class="audit-capture-form-two-cards" id="contact-form">
  <!-- Web3Forms Config -->
  <input type="hidden" name="access_key" value={ACCESS_KEY} />
  <input type="hidden" name="subject" value="Nueva Auditoría Solicitada - LandingInspector" />
  <input type="hidden" name="from_name" value="LandingInspector Auditorías" />
  
  <!-- Inputs Ocultos de Diagnóstico (Inyectados por el Wizard) -->
  <input type="hidden" name="salud_conversion" id="form-score-salud" value="No completada" />
  <input type="hidden" name="tasa_fuga_estimada" id="form-score-fuga" value="No completada" />
  <input type="hidden" name="fallas_detectadas" id="form-fallas" value="Ninguna" />

  <!-- Tarjeta A: Datos de Contacto (Paso 1) -->
  <div class="form-card-part glass-panel" id="form-step-1">
    <div class="card-badge">Paso 1 de 2</div>
    <h3 class="card-title-form">Tus Datos de Contacto</h3>
    <div class="form-card-content">
      <div class="form-group">
        <label for="client-name" class="form-label">Tu Nombre</label>
        <input type="text" name="name" id="client-name" class="form-input" placeholder="Ej: Luis Gabriel" required />
      </div>

      <div class="form-group">
        <label for="client-email" class="form-label">Tu Email de Trabajo</label>
        <input type="email" name="email" id="client-email" class="form-input" placeholder="Ej: contacto@tudominio.com" required />
      </div>

      <div class="form-group">
        <label for="client-phone" class="form-label">WhatsApp / Teléfono <span class="muted-label">(Opcional)</span></label>
        <input type="tel" name="phone" id="client-phone" class="form-input" placeholder="Ej: +1 (604) 555-0199" />
      </div>

      <div class="form-group">
        <label for="client-website" class="form-label">Tu Web o Red Principal</label>
        <input type="url" name="website" id="client-website" class="form-input" placeholder="Ej: https://tudominio.com" required />
      </div>
      
      <div class="form-step-controls">
        <button type="button" class="btn btn-primary btn-next-step" id="btn-form-next">
          Siguiente paso &rarr;
        </button>
      </div>
    </div>
  </div>

  <!-- Tarjeta B: Detalles & Envío (Paso 2) -->
  <div class="form-card-part glass-panel highlighted-form-card" id="form-step-2" style="display: none;">
    <div class="card-badge action-badge">Paso 2 de 2</div>
    <h3 class="card-title-form">Detalles de tu Negocio</h3>
    <div class="form-card-content">
      <div class="form-group">
        <label for="client-message" class="form-label">¿Qué te gustaría mejorar en tu negocio? <span class="muted-label">(Opcional)</span></label>
        <textarea name="message" id="client-message" class="form-textarea" rows="4" placeholder="Ej: Quiero vender más servicios en Vancouver..."></textarea>
      </div>

      <p class="form-agenda-notice">
        ⚠️ <strong>Cupo limitado:</strong> Luis realiza un máximo de 5 auditorías personalizadas en video por semana para garantizar calidad de nivel senior.
      </p>

      <div class="form-step-controls dual-controls">
        <button type="button" class="btn btn-secondary btn-prev-step" id="btn-form-prev">
          &larr; Volver
        </button>
        <button type="submit" class="btn btn-primary btn-submit">
          Pedir auditoría &rarr;
        </button>
      </div>

      <p class="form-security-note">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
          <path fill-rule="evenodd" d="M2.166 4.9c0-.76.37-1.46 1.02-1.87A13.064 13.064 0 0110 1.22c3.19 0 6.14.73 8.813 2.05.65.41 1.02 1.12 1.02 1.87V10c0 5.002-4.086 9.11-9.103 9.87a1 1 0 01-.164 0C5.402 19.11 1.316 15 1.316 10V4.9zM10 5a1 1 0 00-.707.293l-3 3a1 1 0 001.414 1.414L9 7.414V13a1 1 0 102 0V7.414l1.293 1.293a1 1 0 001.414-1.414l-3-3A1 1 0 0010 5z" clip-rule="evenodd" />
        </svg>
        Confidencialidad absoluta bajo NDAs. Cero Spam.
      </p>
    </div>
  </div>
</form>

<style>
  .audit-capture-form-two-cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    height: 100%;
  }

  .form-card-part {
    display: none;
    flex-direction: column;
    padding: 2.25rem 1.75rem;
    border-radius: 12px;
    position: relative;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  /* Mostrar la tarjeta activa en flex */
  .form-card-part#form-step-1 {
    display: flex;
  }

  .form-card-part:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-primary);
  }

  .highlighted-form-card {
    border-color: var(--color-accent-primary);
    box-shadow: 0 8px 30px rgba(245, 165, 36, 0.08);
  }

  .card-badge {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background-color: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .action-badge {
    border-color: rgba(46, 196, 182, 0.3);
    color: #2ec4b6;
    background-color: rgba(46, 196, 182, 0.05);
  }

  .card-title-form {
    font-size: 1.25rem;
    font-family: var(--font-title);
    margin-bottom: 1.5rem;
    color: var(--color-text-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
    font-weight: 700;
  }

  .form-card-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex-grow: 1;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: left;
  }

  .form-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .muted-label {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .form-input, .form-textarea {
    width: 100%;
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.55rem 0.75rem;
    color: var(--color-text-primary);
    font-size: 0.85rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 0 3px var(--color-border-focus);
  }

  .form-textarea {
    resize: vertical;
  }

  .form-agenda-notice {
    font-size: 0.725rem;
    background-color: rgba(245, 165, 36, 0.06);
    border: 1px solid rgba(245, 165, 36, 0.15);
    color: var(--color-text-secondary);
    padding: 0.45rem 0.7rem;
    border-radius: 6px;
    line-height: 1.4;
    margin: 0.15rem 0;
  }

  .form-step-controls {
    display: flex;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .dual-controls {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .btn-next-step, .btn-prev-step {
    padding: 0.65rem 1.25rem;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .btn-submit {
    flex-grow: 1;
    margin-top: 0;
    padding: 0.65rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .form-security-note {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    line-height: 1.3;
    margin-top: 0.25rem;
  }

  .form-security-note svg {
    flex-shrink: 0;
    color: var(--color-text-muted);
  }
</style>

<script>
  const formStep1 = document.getElementById('form-step-1');
  const formStep2 = document.getElementById('form-step-2');
  const btnFormNext = document.getElementById('btn-form-next');
  const btnFormPrev = document.getElementById('btn-form-prev');
  
  // Campos del formulario a validar
  const inputName = document.getElementById('client-name') as HTMLInputElement;
  const inputEmail = document.getElementById('client-email') as HTMLInputElement;
  const inputWebsite = document.getElementById('client-website') as HTMLInputElement;

  if (btnFormNext && formStep1 && formStep2) {
    btnFormNext.addEventListener('click', () => {
      // Validar inputs nativamente
      const isNameValid = inputName.checkValidity();
      const isEmailValid = inputEmail.checkValidity();
      const isWebsiteValid = inputWebsite.checkValidity();

      if (isNameValid && isEmailValid && isWebsiteValid) {
        // Ocultar paso 1 y mostrar paso 2 con animación
        formStep1.style.display = 'none';
        formStep2.style.display = 'flex';
        formStep2.style.animation = 'fadeIn var(--transition-fast) ease-out';
      } else {
        // Reportar los errores de validación de forma nativa en el navegador
        if (!isNameValid) inputName.reportValidity();
        else if (!isEmailValid) inputEmail.reportValidity();
        else if (!isWebsiteValid) inputWebsite.reportValidity();
      }
    });
  }

  if (btnFormPrev && formStep1 && formStep2) {
    btnFormPrev.addEventListener('click', () => {
      // Volver al paso 1
      formStep2.style.display = 'none';
      formStep1.style.display = 'flex';
      formStep1.style.animation = 'fadeIn var(--transition-fast) ease-out';
    });
  }
</script>
