---
// src/components/features/landing/comp-hero.astro
---
<section id="top" class="snap-section hero-section">
  <div class="hero-glow-1"></div>
  <div class="hero-glow-2"></div>
  
  <div class="container hero-container">
    <div class="hero-grid">
      <!-- Columna Izquierda: Mensajes del Hero -->
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span class="badge-text">Auditoría 100% Gratis para Emprendedores Hispanos</span>
        </div>
        
        <h1 class="hero-title">
          Descubre qué está frenando las ventas de tu <span class="highlight-text">marca</span> y tu <span class="highlight-text">web</span>
        </h1>
        
        <p class="hero-subtitle">
          En solo 2 minutos, punto por punto: identifica qué te hace ver poco profesional online y qué debes arreglar primero. Sin tecnicismos, directo y totalmente gratis.
        </p>
        
        <div class="hero-actions">
          <a href="#audit" class="btn btn-primary btn-lg-scale">
            Hacer mi auto-auditoría &rarr;
          </a>
          <a href="#offer" class="btn btn-secondary btn-lg-scale">
            Pedir auditoría personal
          </a>
        </div>
        
        <div class="hero-footer-note">
          <svg class="trust-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="20" height="20">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138z" />
          </svg>
          <span>Hecha por un developer con 20+ años de experiencia — no una agencia de plantillas.</span>
        </div>
      </div>
      
      <!-- Columna Derecha: Composición Visual en 3D (Tablet & Tarjetas Flotantes) -->
      <div class="hero-visual">
        <div class="scene-3d">
          
          <!-- Tablet / Panel Principal -->
          <div class="tablet-mockup glass-panel">
            <div class="tablet-header">
              <span class="tablet-dot-btn red"></span>
              <span class="tablet-dot-btn yellow"></span>
              <span class="tablet-dot-btn green"></span>
              <span class="tablet-title">Auditoría de tu negocio</span>
            </div>
            
            <div class="tablet-body">
              <!-- Bloque General de Puntaje -->
              <div class="score-card">
                <span class="score-label">Puntaje general</span>
                <div class="radial-progress">
                  <svg viewBox="0 0 100 100">
                    <circle class="bg" cx="50" cy="50" r="40" />
                    <circle class="fill" cx="50" cy="50" r="40" />
                  </svg>
                  <div class="score-number">
                    <span class="num">62</span>
                    <span class="total">/100</span>
                  </div>
                </div>
                <span class="score-status">Regular</span>
                <p class="score-desc">Hay oportunidades importantes para mejorar tus resultados.</p>
              </div>
              
              <!-- Bloque de Áreas Evaluadas -->
              <div class="areas-card">
                <span class="score-label">Áreas evaluadas</span>
                <div class="area-rows">
                  
                  <div class="area-row">
                    <div class="area-info">
                      <span class="area-name">Sitio Web</span>
                      <span class="area-score">50/100</span>
                    </div>
                    <div class="bar-container"><div class="bar orange" style="width: 50%;"></div></div>
                  </div>

                  <div class="area-row">
                    <div class="area-info">
                      <span class="area-name">SEO Local</span>
                      <span class="area-score">70/100</span>
                    </div>
                    <div class="bar-container"><div class="bar yellow" style="width: 70%;"></div></div>
                  </div>

                  <div class="area-row">
                    <div class="area-info">
                      <span class="area-name">Presencia Online</span>
                      <span class="area-score">40/100</span>
                    </div>
                    <div class="bar-container"><div class="bar red" style="width: 40%;"></div></div>
                  </div>

                  <div class="area-row">
                    <div class="area-info">
                      <span class="area-name">Conversión</span>
                      <span class="area-score">65/100</span>
                    </div>
                    <div class="bar-container"><div class="bar yellow" style="width: 65%;"></div></div>
                  </div>

                  <div class="area-row">
                    <div class="area-info">
                      <span class="area-name">Confianza y Credibilidad</span>
                      <span class="area-score">80/100</span>
                    </div>
                    <div class="bar-container"><div class="bar green" style="width: 80%;"></div></div>
                  </div>

                </div>
              </div>
            </div>
          </div>
          
          <!-- Tarjetas Flotantes en 3D -->
          
          <!-- 1. Tarjeta Oportunidades (Flota Abajo Izquierda) -->
          <div class="floating-card opportunities-card glass-panel float-anim-1">
            <div class="opt-icon">🚀</div>
            <div class="opt-text">
              <span class="opt-label">Oportunidades</span>
              <span class="opt-value">12 <span class="opt-sub">acciones clave</span></span>
              <span class="opt-desc">para mejorar tus ventas</span>
            </div>
          </div>
          
          <!-- 2. Tarjeta Rendimiento (Flota Abajo Centro) -->
          <div class="floating-card chart-line-card glass-panel float-anim-2">
            <span class="chart-title">Rendimiento</span>
            <div class="chart-lines-svg">
              <svg viewBox="0 0 120 40" class="sparkline">
                <path d="M5,32 Q25,8 45,26 T80,18 T115,10" fill="none" stroke="var(--color-accent-primary)" stroke-width="2.5" stroke-linecap="round" />
                <circle cx="115" cy="10" r="3.5" fill="var(--color-accent-primary)" />
              </svg>
            </div>
          </div>
          
          <!-- 3. Tarjeta Visibilidad (Flota Abajo Derecha) -->
          <div class="floating-card chart-bar-card glass-panel float-anim-3">
            <span class="chart-title">Visibilidad en Google</span>
            <div class="chart-bars-container">
              <div class="bar-col" style="height: 35%;"></div>
              <div class="bar-col" style="height: 65%;"></div>
              <div class="bar-col" style="height: 48%;"></div>
              <div class="bar-col" style="height: 80%;"></div>
              <div class="bar-col" style="height: 52%;"></div>
              <div class="bar-col" style="height: 95%;"></div>
            </div>
          </div>
          
        </div>
      </div>
    </div>

    <!-- Barra de Características Inferior -->
    <div class="hero-features-bar glass-panel">
      <div class="feature-item">
        <div class="feature-icon-box">⚡</div>
        <div class="feature-text">
          <strong class="feature-title">Rápido y simple</strong>
          <span class="feature-desc">Responde en 2 minutos y obtén tu diagnóstico.</span>
        </div>
      </div>
      <div class="feature-item">
        <div class="feature-icon-box">🎯</div>
        <div class="feature-text">
          <strong class="feature-title">Enfocado en resultados</strong>
          <span class="feature-desc">Te decimos exactamente qué te está haciendo perder ventas.</span>
        </div>
      </div>
      <div class="feature-item">
        <div class="feature-icon-box">🛡️</div>
        <div class="feature-text">
          <strong class="feature-title">100% Gratis</strong>
          <span class="feature-desc">Sin tarjetas, sin trampas. Solo valor real.</span>
        </div>
      </div>
      <div class="feature-item">
        <div class="feature-icon-box">👥</div>
        <div class="feature-text">
          <strong class="feature-title">Hecho para emprendedores</strong>
          <span class="feature-desc">Entendemos tu negocio, hablamos tu idioma.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: transparent;
    transition: background-color var(--transition-slow);
    z-index: 1;
    position: relative;
    padding: 6rem 0 3rem 0;
    min-height: 100vh;
  }

  /* Fondo de luces de neón decorativas */
  .hero-glow-1 {
    position: absolute;
    top: 10%;
    left: 20%;
    width: 45vw;
    height: 35vw;
    background: radial-gradient(circle, rgba(245, 165, 36, 0.05) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(60px);
    z-index: -1;
    pointer-events: none;
  }

  .hero-glow-2 {
    position: absolute;
    bottom: 0%;
    right: 20%;
    width: 40vw;
    height: 30vw;
    background: radial-gradient(circle, rgba(245, 165, 36, 0.04) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(70px);
    z-index: -1;
    pointer-events: none;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    width: 100%;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 1.75rem;
    max-width: 650px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 50px;
    backdrop-filter: blur(10px);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-accent-primary);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .badge-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .hero-title {
    font-size: 3.25rem;
    font-family: var(--font-title);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    line-height: 1.15;
  }

  .highlight-text {
    position: relative;
    display: inline-block;
    color: var(--color-accent-primary);
  }

  :global([data-theme="brand"]) .highlight-text {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: #f5a524;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .btn-lg-scale {
    padding: 1rem 2rem;
    font-size: 1rem;
  }

  .hero-footer-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  .trust-icon {
    color: var(--color-accent-primary);
    flex-shrink: 0;
  }

  :global([data-theme="brand"]) .trust-icon {
    color: var(--color-text-primary);
  }

  /* --- Columna Derecha: Escena 3D --- */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    width: 100%;
  }

  .scene-3d {
    position: relative;
    perspective: 1200px;
    width: 440px;
    height: 380px;
  }

  /* Mockup de la Tablet en 3D */
  .tablet-mockup {
    width: 380px;
    background-color: rgba(20, 20, 24, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1rem 1.25rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transform: rotateY(-22deg) rotateX(16deg) rotateZ(5deg);
    box-shadow: -20px 20px 40px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(15px);
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
  }

  :global([data-theme="brand"]) .tablet-mockup {
    background-color: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(27, 42, 86, 0.1);
    box-shadow: -20px 20px 40px rgba(27, 42, 86, 0.08);
  }

  .tablet-header {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 0.5rem;
  }

  :global([data-theme="brand"]) .tablet-header {
    border-bottom: 1px solid rgba(27, 42, 86, 0.06);
  }

  .tablet-dot-btn {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .tablet-dot-btn.red { background-color: #ff5f56; }
  .tablet-dot-btn.yellow { background-color: #ffbd2e; }
  .tablet-dot-btn.green { background-color: #27c93f; }

  .tablet-title {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-left: 0.5rem;
  }

  .tablet-body {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 1rem;
    align-items: start;
  }

  /* Bloque de Puntaje */
  .score-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 8px;
    padding: 0.75rem 0.5rem;
    text-align: center;
  }

  :global([data-theme="brand"]) .score-card {
    background-color: rgba(27, 42, 86, 0.02);
    border: 1px solid rgba(27, 42, 86, 0.04);
  }

  .score-label {
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    margin-bottom: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .radial-progress {
    position: relative;
    width: 70px;
    height: 70px;
  }

  .radial-progress svg {
    transform: rotate(-90deg);
    width: 100%;
    height: 100%;
  }

  .radial-progress circle {
    fill: none;
    stroke-width: 8;
  }

  .radial-progress circle.bg {
    stroke: rgba(255, 255, 255, 0.05);
  }

  :global([data-theme="brand"]) .radial-progress circle.bg {
    stroke: rgba(27, 42, 86, 0.05);
  }

  .radial-progress circle.fill {
    stroke: var(--color-accent-primary);
    stroke-linecap: round;
    stroke-dasharray: 251.2;
    stroke-dashoffset: 95.5; /* 62% progress fill */
  }

  .score-number {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .score-number .num {
    font-size: 1.15rem;
    font-weight: 800;
    font-family: var(--font-title);
    color: var(--color-text-primary);
  }

  .score-number .total {
    font-size: 0.5rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .score-status {
    font-size: 0.725rem;
    font-weight: 800;
    color: var(--color-accent-primary);
    margin-top: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .score-desc {
    font-size: 0.55rem;
    color: var(--color-text-muted);
    line-height: 1.35;
    margin-top: 0.35rem;
  }

  /* Bloque de Áreas Evaluadas */
  .areas-card {
    display: flex;
    flex-direction: column;
    background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 8px;
    padding: 0.75rem;
  }

  :global([data-theme="brand"]) .areas-card {
    background-color: rgba(27, 42, 86, 0.02);
    border: 1px solid rgba(27, 42, 86, 0.04);
  }

  .area-rows {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .area-row {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .area-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.55rem;
    font-weight: 600;
  }

  .area-name {
    color: var(--color-text-secondary);
  }

  .area-score {
    color: var(--color-text-muted);
  }

  .bar-container {
    width: 100%;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 2px;
    overflow: hidden;
  }

  :global([data-theme="brand"]) .bar-container {
    background-color: rgba(27, 42, 86, 0.05);
  }

  .bar {
    height: 100%;
    border-radius: 2px;
  }

  .bar.orange { background-color: var(--color-accent-primary); }
  .bar.yellow { background-color: #ffbd2e; }
  .bar.red { background-color: var(--color-accent-secondary); }
  .bar.green { background-color: #2ec4b6; }

  /* --- Tarjetas Flotantes en 3D --- */
  .floating-card {
    position: absolute;
    border-radius: 12px;
    padding: 0.8rem 1rem;
    box-shadow: -10px 15px 30px rgba(0, 0, 0, 0.4);
    z-index: 3;
    transform: rotateY(-22deg) rotateX(16deg) rotateZ(5deg) translateZ(35px);
  }

  /* 1. Tarjeta Oportunidades */
  .opportunities-card {
    bottom: -15px;
    left: -40px;
    width: 175px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background-color: rgba(22, 22, 26, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global([data-theme="brand"]) .opportunities-card {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(27, 42, 86, 0.08);
    box-shadow: -10px 15px 30px rgba(27, 42, 86, 0.06);
  }

  .opt-icon {
    font-size: 1.5rem;
  }

  .opt-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .opt-label {
    font-size: 0.5rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .opt-value {
    font-size: 1.25rem;
    font-weight: 800;
    font-family: var(--font-title);
    color: var(--color-text-primary);
  }

  .opt-sub {
    font-size: 0.55rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .opt-desc {
    font-size: 0.5rem;
    color: var(--color-text-muted);
  }

  /* 2. Tarjeta Gráfico de Líneas (Rendimiento) */
  .chart-line-card {
    bottom: -25px;
    left: 155px;
    width: 120px;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background-color: rgba(22, 22, 26, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.6rem 0.8rem;
  }

  :global([data-theme="brand"]) .chart-line-card {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(27, 42, 86, 0.08);
    box-shadow: -10px 15px 30px rgba(27, 42, 86, 0.06);
  }

  .chart-title {
    font-size: 0.55rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .chart-lines-svg {
    width: 100%;
    height: 35px;
    display: flex;
    align-items: flex-end;
  }

  .sparkline {
    width: 100%;
    height: 100%;
  }

  /* 3. Tarjeta Gráfico de Barras (Visibilidad) */
  .chart-bar-card {
    bottom: 50px;
    right: -30px;
    width: 110px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background-color: rgba(22, 22, 26, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.6rem 0.8rem;
  }

  :global([data-theme="brand"]) .chart-bar-card {
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(27, 42, 86, 0.08);
    box-shadow: -10px 15px 30px rgba(27, 42, 86, 0.06);
  }

  .chart-bars-container {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    height: 40px;
    gap: 4px;
    padding-top: 0.25rem;
  }

  .bar-col {
    width: 100%;
    background-color: rgba(46, 196, 182, 0.4);
    border-radius: 2px;
    transition: background-color var(--transition-fast);
  }

  :global([data-theme="brand"]) .bar-col {
    background-color: rgba(27, 42, 86, 0.3);
  }

  .bar-col:nth-child(4) {
    background-color: var(--color-accent-primary);
  }

  .bar-col:last-child {
    background-color: rgba(46, 196, 182, 0.85);
  }

  :global([data-theme="brand"]) .bar-col:last-child {
    background-color: rgba(27, 42, 86, 0.7);
  }

  /* Animations for floating elements */
  .float-anim-1 {
    animation: float1 6s ease-in-out infinite;
  }
  .float-anim-2 {
    animation: float2 5.5s ease-in-out infinite;
  }
  .float-anim-3 {
    animation: float3 6.5s ease-in-out infinite;
  }

  @keyframes float1 {
    0%, 100% { transform: rotateY(-22deg) rotateX(16deg) rotateZ(5deg) translateZ(35px) translateY(0px); }
    50% { transform: rotateY(-22deg) rotateX(16deg) rotateZ(5deg) translateZ(35px) translateY(-8px); }
  }

  @keyframes float2 {
    0%, 100% { transform: rotateY(-22deg) rotateX(16deg) rotateZ(5deg) translateZ(35px) translateY(0px); }
    50% { transform: rotateY(-22deg) rotateX(16deg) rotateZ(5deg) translateZ(35px) translateY(-10px); }
  }

  @keyframes float3 {
    0%, 100% { transform: rotateY(-22deg) rotateX(16deg) rotateZ(5deg) translateZ(35px) translateY(0px); }
    50% { transform: rotateY(-22deg) rotateX(16deg) rotateZ(5deg) translateZ(35px) translateY(-7px); }
  }

  /* --- Barra de Características Inferior --- */
  .hero-features-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    width: 100%;
    margin-top: 5rem;
