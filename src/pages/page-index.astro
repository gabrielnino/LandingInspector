---
// src/pages/page-index.astro
import '../styles/style-variables.css';
import '../styles/style-global.css';

import CompNavbar from '../components/shared/comp-navbar.astro';
import CompHero from '../components/features/landing/comp-hero.astro';
import CompAuditTool from '../components/features/landing/comp-audit-tool.astro';
import CompAuditForm from '../components/features/landing/comp-audit-form.astro';
import CompServices from '../components/features/landing/comp-services.astro';
import CompCases from '../components/features/landing/comp-cases.astro';
import CompOfferDetails from '../components/features/landing/comp-offer-details.astro';
import CompFaq from '../components/features/landing/comp-faq.astro';
import CompFooter from '../components/shared/comp-footer.astro';

// Metadatos SEO
const title = "Auto-Auditoría de Conversión Web Gratuita | Luis Niño Developer";
const description = "Descubre en 2 minutos qué está frenando las ventas de tu web y tu marca. Diagnóstico 100% gratuito para emprendedores en Canadá y EE. UU.";
const canonicalUrl = "https://landinginspector.com/";
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  
  <!-- Favicons Dinámicos / Estáticos por Media Queries -->
  <link rel="icon" type="image/svg+xml" href="/favicon-brand.svg" media="(prefers-color-scheme: light)" />
  <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Metatags de Configuración de Color Móvil -->
  <meta name="theme-color" content="#0e1424" />

  <!-- Optimización de Fuentes (Preconnect) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Sora:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  
  <!-- SEO Básico -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />
  
  <!-- Open Graph / Redes Sociales -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Luis Niño Developer" />
  <meta property="og:image" content="https://landinginspector.com/favicon-brand.svg" />
  <meta property="og:image:alt" content="Logotipo Oficial de LandingInspector" />
  <meta property="og:image:type" content="image/svg+xml" />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://landinginspector.com/favicon-brand.svg" />

  <!-- Meta Pixel Code -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '2189856438529347');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=2189856438529347&ev=PageView&noscript=1" /></noscript>
  <!-- End Meta Pixel Code -->
</head>
<body>
  <!-- Barra de navegación fija -->
  <CompNavbar />
  
  <!-- Contenedor del Scroll Snapping Vertical -->
  <main class="snap-container">
    
    <!-- Sección 1: Hero -->
    <CompHero />
    
    <!-- Sección 2: Herramienta de Auto-Auditoría con formulario en slot -->
    <CompAuditTool>
      <CompAuditForm slot="capture-form" />
    </CompAuditTool>
    
    <!-- Sección 3: Catálogo de Servicios -->
    <CompServices />
    
    <!-- Sección 4: Casos de Éxito / Prueba Social -->
    <CompCases />
    
    <!-- Sección 5: Sobre Mí, Detalle de Oferta Gratuita y Retorno -->
    <CompOfferDetails />
    
    <!-- Sección 6 (FAQ) e Integración del Footer final -->
    <CompFaq />
    
    <CompFooter />
  </main>
</body>
</html>
